# Supply-chain hardening (per SECURITY.md)
# - ignore-scripts: block all postinstall script execution (Shai-Hulud class defense)
# - save-exact: pin exact versions, no caret/tilde drift
# - audit-level: fail audit on moderate or higher
# - fund/update-notifier: silence noise in CI
ignore-scripts=true
save-exact=true
audit-level=moderate
fund=false
update-notifier=false
